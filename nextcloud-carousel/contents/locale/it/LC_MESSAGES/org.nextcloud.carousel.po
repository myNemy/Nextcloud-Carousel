#: contents/ui/config.qml:35
msgid "Nextcloud URL:"
msgstr "URL Nextcloud:"

#: contents/ui/config.qml:36
msgid "https://nextcloud.example.com"
msgstr "https://nextcloud.example.com"

#: contents/ui/config.qml:39
msgid "URL of your Nextcloud server (e.g., https://nextcloud.example.com)"
msgstr "URL del tuo server Nextcloud (es. https://nextcloud.example.com)"

#: contents/ui/config.qml:44
msgid "Username:"
msgstr "Nome utente:"

#: contents/ui/config.qml:45
msgid "Your Nextcloud username"
msgstr "Il tuo nome utente Nextcloud"

#: contents/ui/config.qml:48
msgid "Your Nextcloud username for authentication"
msgstr "Il tuo nome utente Nextcloud per l'autenticazione"

#: contents/ui/config.qml:53
msgid "Password:"
msgstr "Password:"

#: contents/ui/config.qml:54
msgid "Password or app password"
msgstr "Password o password app"

#: contents/ui/config.qml:58
msgid "Your Nextcloud password or app password (recommended for security)"
msgstr "La tua password Nextcloud o password app (consigliata per la sicurezza)"

#: contents/ui/config.qml:63
msgid "Photo Path:"
msgstr "Percorso Foto:"

#: contents/ui/config.qml:64
msgid "/Photos"
msgstr "/Photos"

#: contents/ui/config.qml:67
msgid "Path to the photo folder on Nextcloud (searches in subfolders too)"
msgstr "Percorso alla cartella foto su Nextcloud (cerca anche nelle sottocartelle)"

#: contents/ui/config.qml:72
msgid "Slide Interval (seconds):"
msgstr "Intervallo Slide (secondi):"

#: contents/ui/config.qml:73
msgid "10"
msgstr "10"

#: contents/ui/config.qml:76
msgid "Time each image is displayed before switching to the next"
msgstr "Tempo in cui ogni immagine viene visualizzata prima di passare alla successiva"

#: contents/ui/config.qml:128
msgid "Order Mode:"
msgstr "Modalità Ordine:"

#: contents/ui/config.qml:130
msgid "Sequential"
msgstr "Sequenziale"

#: contents/ui/config.qml:131
msgid "Random (each time)"
msgstr "Casuale (ogni volta)"

#: contents/ui/config.qml:132
msgid "Shuffle Once"
msgstr "Mescola Una Volta"

#: contents/ui/config.qml:133
msgid "Smart Random (avoid repeats)"
msgstr "Casuale Intelligente (evita ripetizioni)"

#: contents/ui/config.qml:138
msgid "Sequential: in order | Random: random each time | Shuffle: shuffle once | Smart: avoids recent repeats"
msgstr "Sequenziale: in ordine | Casuale: casuale ogni volta | Mescola: mescola una volta | Intelligente: evita ripetizioni recenti"

#: contents/ui/config.qml:143
msgid "Blur background:"
msgstr "Sfondo sfocato:"

#: contents/ui/config.qml:144
msgid "Apply blur effect to images"
msgstr "Applica effetto sfocatura alle immagini"

#: contents/ui/config.qml:147
msgid "Apply a blur effect to the images for a softer, artistic appearance"
msgstr "Applica un effetto sfocatura alle immagini per un aspetto più morbido e artistico"

#: contents/ui/config.qml:151
msgid "Blur opacity (%):"
msgstr "Opacità Sfocatura (%):"

#: contents/ui/config.qml:169
msgid "Opacity of the blur effect (0% = no blur, 100% = maximum blur)"
msgstr "Opacità dell'effetto sfocatura (0% = nessuna sfocatura, 100% = sfocatura massima)"

#: contents/ui/config.qml:182
msgid "Fill Mode:"
msgstr "Modalità Riempimento:"

#: contents/ui/config.qml:184
msgid "Stretch"
msgstr "Allunga"

#: contents/ui/config.qml:185
msgid "Fit (Preserve Aspect)"
msgstr "Adatta (Mantieni Proporzioni)"

#: contents/ui/config.qml:186
msgid "Crop (Preserve Aspect)"
msgstr "Ritaglia (Mantieni Proporzioni)"

#: contents/ui/config.qml:187
msgid "Tile"
msgstr "Piastrella"

#: contents/ui/config.qml:188
msgid "Tile Vertically"
msgstr "Piastrella Verticalmente"

#: contents/ui/config.qml:189
msgid "Tile Horizontally"
msgstr "Piastrella Orizzontalmente"

#: contents/ui/config.qml:194
msgid "How the image is displayed: Stretch fills screen, Fit preserves aspect, Crop fills without distortion, Tile repeats"
msgstr "Come viene visualizzata l'immagine: Allunga riempie lo schermo, Adatta mantiene le proporzioni, Ritaglia riempie senza distorsione, Piastrella ripete"

#: contents/ui/config.qml:198
msgid "Image Scale (%):"
msgstr "Scala Immagine (%):"

#: contents/ui/config.qml:215
msgid "Scale image size (50% = half size, 100% = normal, 200% = double)"
msgstr "Scala la dimensione dell'immagine (50% = metà dimensione, 100% = normale, 200% = doppio)"

#: contents/ui/config.qml:228
msgid "Background Color:"
msgstr "Colore di Sfondo:"

#: contents/ui/config.qml:229
msgid "Select Background Color"
msgstr "Seleziona Colore di Sfondo"

#: contents/ui/config.qml:232
msgid "Background color shown while loading or if image doesn't fill screen"
msgstr "Colore di sfondo mostrato durante il caricamento o se l'immagine non riempie lo schermo"

#: contents/ui/config.qml:237
msgid "Loading Indicator:"
msgstr "Indicatore di Caricamento:"

#: contents/ui/config.qml:238
msgid "Show loading indicator when loading images"
msgstr "Mostra indicatore di caricamento durante il caricamento delle immagini"

#: contents/ui/config.qml:241
msgid "Display a visual indicator while images are being loaded from Nextcloud"
msgstr "Mostra un indicatore visivo mentre le immagini vengono caricate da Nextcloud"

#: contents/ui/config.qml:248
msgid "EXIF Information:"
msgstr "Informazioni EXIF:"

#: contents/ui/config.qml:249
msgid "Show EXIF information overlay (OSD)"
msgstr "Mostra overlay informazioni EXIF (OSD)"

#: contents/ui/config.qml:252
msgid "Display EXIF metadata (date, camera, ISO, etc.) as an overlay when images change"
msgstr "Mostra metadati EXIF (data, fotocamera, ISO, ecc.) come overlay quando cambiano le immagini"

#: contents/ui/config.qml:256
msgid "EXIF Info Duration (seconds):"
msgstr "Durata Info EXIF (secondi):"

#: contents/ui/config.qml:260
msgid "5"
msgstr "5"

#: contents/ui/config.qml:264
msgid "How long to show EXIF information (0 = always visible, 1-30 = auto-hide after N seconds)"
msgstr "Quanto tempo mostrare le informazioni EXIF (0 = sempre visibile, 1-30 = nascondi automaticamente dopo N secondi)"

#: contents/ui/main.qml
msgid "EXIF Information"
msgstr "Informazioni EXIF"

#: contents/ui/main.qml
msgid "Date: %1"
msgstr "Data: %1"

#: contents/ui/main.qml
msgid "Camera: %1"
msgstr "Fotocamera: %1"

#: contents/ui/main.qml
msgid "ISO: %1"
msgstr "ISO: %1"

#: contents/ui/main.qml
msgid "Aperture: f/%1"
msgstr "Apertura: f/%1"

#: contents/ui/main.qml
msgid "Exposure: %1"
msgstr "Esposizione: %1"

#: contents/ui/main.qml
msgid "Orientation: 90°"
msgstr "Orientamento: 90°"

#: contents/ui/main.qml
msgid "Orientation: -90°"
msgstr "Orientamento: -90°"

#: contents/ui/main.qml
msgid "Orientation: 180°"
msgstr "Orientamento: 180°"

#: contents/ui/main.qml
msgid "Orientation: Normal"
msgstr "Orientamento: Normale"

#: contents/ui/config.qml
msgid "Fallback QML:"
msgstr "Fallback QML:"

#: contents/ui/config.qml
msgid "Allow Data URL download when C++ downloader is missing or fails"
msgstr "Consenti download Data URL se il downloader C++ manca o fallisce"

#: contents/ui/config.qml
msgid "When checked, the wallpaper can load images via QML (in-memory Data URLs) if the optional C++ module is not installed or a download error occurs.\n\nUncheck to use only the C++ file-based pipeline: slides are skipped until the C++ module works. Reduces memory use and avoids the slower path, but requires the C++ plugin (see README / install.sh)."
msgstr "Se attivo, lo sfondo può caricare le immagini via QML (Data URL in memoria) se il modulo C++ opzionale non è installato o si verifica un errore di download.\n\nDisattiva per usare solo la pipeline C++ su file: le slide vengono saltate finché il modulo C++ non funziona. Riduce l’uso di memoria e evita il percorso più lento, ma richiede il plugin C++ (vedi README / install.sh)."

