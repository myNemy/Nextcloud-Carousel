<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <entry name="NextcloudUrl" type="String">
      <label>Nextcloud server URL</label>
      <default></default>
    </entry>
    <entry name="Username" type="String">
      <label>Nextcloud username</label>
      <default></default>
    </entry>
    <entry name="Password" type="String">
      <label>Nextcloud password or app password</label>
      <default></default>
    </entry>
    <entry name="PhotoPath" type="String">
      <label>Path to photos folder in Nextcloud</label>
      <default>/Photos</default>
    </entry>
    <entry name="SlideInterval" type="int">
      <label>Interval between slides (seconds)</label>
      <default>10</default>
    </entry>
    <entry name="TransitionDuration" type="int">
      <label>Transition animation duration (milliseconds)</label>
      <default>1000</default>
    </entry>
    <entry name="TransitionEnabled" type="bool">
      <label>Enable transitions between images</label>
      <default>true</default>
    </entry>
    <entry name="TransitionRandom" type="bool">
      <label>Randomize transition type for each image</label>
      <default>false</default>
    </entry>
    <entry name="TransitionType" type="int">
      <label>Transition type: 0=Fade, 1=Slide, 2=Zoom (used when random is disabled)</label>
      <default>0</default>
    </entry>
    <entry name="RandomOrder" type="int">
      <label>Order mode: 0=Sequential, 1=Random, 2=Shuffle once, 3=Smart random (avoid repeats)</label>
      <default>0</default>
    </entry>
    <entry name="Blur" type="bool">
      <label>Blur background filling</label>
      <default>false</default>
    </entry>
    <entry name="BlurOpacity" type="int">
      <label>Blur opacity percentage (0-100, lower = more transparent)</label>
      <default>75</default>
      <min>0</min>
      <max>100</max>
    </entry>
    <entry name="Color" type="Color">
      <label>Background color</label>
      <default>#000000</default>
    </entry>
    <entry name="FillMode" type="int">
      <label>Sizing, cropping and positioning of the wallpaper image</label>
      <default>2</default>
    </entry>
    <entry name="ImageScale" type="int">
      <label>Image scale percentage (50-200, 100 = normal size)</label>
      <default>100</default>
      <min>50</min>
      <max>200</max>
    </entry>
    <entry name="ShowLoadingIndicator" type="bool">
      <label>Show loading indicator when loading images</label>
      <default>true</default>
    </entry>
    <entry name="ShowExifInfo" type="bool">
      <label>Show EXIF information overlay (OSD)</label>
      <default>false</default>
    </entry>
    <entry name="ExifInfoDuration" type="int">
      <label>EXIF info display duration (seconds, 0 = always visible)</label>
      <default>5</default>
      <min>0</min>
      <max>30</max>
    </entry>
    <entry name="ShowLocationOsd" type="bool">
      <label>Show permanent location overlay</label>
      <default>false</default>
    </entry>
    <entry name="LocationOsdFontSize" type="int">
      <label>Location OSD font size (pixels)</label>
      <default>24</default>
      <min>12</min>
      <max>72</max>
    </entry>
    <entry name="LocationOsdPosition" type="int">
      <label>Location OSD position: 0=Top-Left, 1=Top-Right, 2=Bottom-Left, 3=Bottom-Right, 4=Top-Center, 5=Bottom-Center</label>
      <default>1</default>
      <min>0</min>
      <max>5</max>
    </entry>
    <entry name="LocationOsdXOffset" type="int">
      <label>Location OSD horizontal offset (pixels)</label>
      <default>20</default>
      <min>-200</min>
      <max>200</max>
    </entry>
    <entry name="LocationOsdYOffset" type="int">
      <label>Location OSD vertical offset (pixels)</label>
      <default>20</default>
      <min>-200</min>
      <max>200</max>
    </entry>
    <entry name="LocationOsdFontFamily" type="String">
      <label>Location OSD font family</label>
      <default></default>
    </entry>
    <entry name="MaxImageSizeMB" type="int">
      <label>Maximum image size limit in MB (0 = auto-detect, 3-30 recommended)</label>
      <default>0</default>
      <min>0</min>
      <max>50</max>
      <whatsthis>Maximum size for images to be loaded. Images larger than this will be skipped to prevent memory issues. Set to 0 for automatic detection (default: 5MB). Recommended values: 3MB for low-end systems, 5-10MB for mid-range, 10-15MB for high-end systems (16GB+ RAM).</whatsthis>
    </entry>
    <entry name="ShowMethodIndicator" type="bool">
      <label>Show processing method indicator (QML/C++)</label>
      <default>false</default>
      <whatsthis>Shows a small badge in the top-right corner indicating whether the current image is processed using QML (Data URLs) or C++ (file temporanei). Green badge = C++ (optimized), Blue badge = QML (standard).</whatsthis>
    </entry>
    <entry name="MethodIndicatorDuration" type="int">
      <label>Method indicator display duration (seconds, 0 = always visible)</label>
      <default>3</default>
      <min>0</min>
      <max>30</max>
      <whatsthis>How long to show the method indicator after an image loads. Set to 0 to keep it always visible.</whatsthis>
    </entry>
  </group>
</kcfg>

